@startuml
hide empty members
skinparam classAttributeIconSize 0

class Destination {
  - destinationId: String
  - destinationName: String
  - region: String
  - baseCost: double
  + Destination()
  + Destination(id: String, name: String, region: String, baseCost: double)
  + getDestinationId(): String
  + setDestinationId(id: String): void
  + getDestinationName(): String
  + setDestinationName(name: String): void
  + getRegion(): String
  + setRegion(region: String): void
  + getBaseCost(): double
  + setBaseCost(baseCost: double): void
  + toString(): String
}

class Tour {
  - tourId: String
  - destination: Destination
  - tourName: String
  - departureDate: String
  - price: double
  + Tour()
  + Tour(id: String, destination: Destination, name: String, date: String, price: double)
  + getTourId(): String
  + setTourId(id: String): void
  + getDestination(): Destination
  + setDestination(destination: Destination): void
  + getTourName(): String
  + setTourName(name: String): void
  + getDepartureDate(): String
  + setDepartureDate(date: String): void
  + getPrice(): double
  + setPrice(price: double): void
  + compareTo(other: Tour): int
  + toString(): String
  + screenString(): String
}

class DestinationList {
  + loadFromFile(filename: String): boolean
  + saveToFile(filename: String): boolean
  + searchId(id: String): int
  + addDestination(): void
  + updateDestination(): boolean
  + listDestinations(): void
  + getUserChoice(): Destination
}

class TourList {
  + loadFromFile(filename: String, destinations: DestinationList): boolean
  + saveToFile(filename: String): boolean
  + searchId(id: String): int
  + addTour(destinations: DestinationList): void
  + removeTour(): boolean
  + updateTour(destinations: DestinationList): boolean
  + listTours(): void
  + printBasedDestinationName(): void
}

class Menu {
  + {static} <E> intGetChoice(options: ArrayList<E>): int
  + {static} <E> refGetChoice(options: ArrayList<E>): E
}

class TourManager {
  + {static} main(args: String[]): void
}

Tour --> Destination : one destination
DestinationList --|> ArrayList~Destination~
TourList --|> ArrayList~Tour~
Tour ..|> Comparable~Tour~
TourManager ..> Menu
TourManager ..> DestinationList
TourManager ..> TourList
TourList ..> DestinationList : resolves destination IDs
@enduml
